{
  "name": "filter-is-not-empty-text",
  "description": "is_not_empty on a text column excludes NULL and ''.",
  "context": {
    "now": "2026-10-27T10:00:00+03:00",
    "timezone": "Europe/Istanbul"
  },
  "request": {
    "queries": {
      "q": {
        "source": "order",
        "fields": [
          "code",
          "note"
        ],
        "filters": [
          {
            "column": "note",
            "op": "is_not_empty"
          }
        ]
      }
    }
  },
  "response": {
    "status": 200,
    "body": {
      "results": {
        "q": {
          "rows": [
            {
              "id": 1,
              "code": "SO-1001",
              "note": "Urgent"
            },
            {
              "id": 4,
              "code": "SO-1004",
              "note": "Deliver with SO-1001"
            },
            {
              "id": 6,
              "code": "SO-1006",
              "note": "Awaiting PO"
            }
          ],
          "page": {
            "number": 1,
            "size": 50,
            "hasMore": false
          }
        }
      }
    }
  }
}
