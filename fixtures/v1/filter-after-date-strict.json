{
  "name": "filter-after-date-strict",
  "description": "after is strict: Oct 5 itself is excluded; NULL never matches.",
  "context": {
    "now": "2026-10-27T10:00:00+03:00",
    "timezone": "Europe/Istanbul"
  },
  "request": {
    "queries": {
      "q": {
        "source": "order",
        "fields": [
          "code",
          "due_date"
        ],
        "filters": [
          {
            "column": "due_date",
            "op": "after",
            "value": "2026-10-05"
          }
        ]
      }
    }
  },
