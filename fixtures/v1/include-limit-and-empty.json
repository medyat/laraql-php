{
  "name": "include-limit-and-empty",
  "description": "limit caps rows per parent; a parent without related rows gets an empty list.",
  "context": {
    "now": "2026-10-27T10:00:00+03:00",
    "timezone": "Europe/Istanbul"
  },
  "request": {
    "queries": {
      "q": {
        "source": "order",
        "fields": [
          "code"
        ],
        "filters": [
          {
            "column": "code",
            "op": "in",
            "value": [
              "SO-1001",
              "SO-1003"
            ]
          }
        ],
        "include": {
          "lines": {
            "fields": [
              "product_code"
            ],
            "sort": [
              {
                "column": "position",
                "dir": "asc"
              }
            ],
            "limit": 1
          }
        }
      }
    }
  },
  "response": {
    "status": 200,
    "body": {
      "results": {
        "q": {
          "rows": [
            {
              "id": 1,
              "code": "SO-1001",
              "lines": [
                {
                  "id": 1,
                  "product_code": "HC-80"
                }
              ]
            },
            {
              "id": 3,
              "code": "SO-1003",
              "lines": []
            }
          ],
          "page": {
            "number": 1,
            "size": 50,
            "hasMore": false
          }
        }
      }
    }
  }
}
